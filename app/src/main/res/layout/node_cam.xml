<?xml version="1.0" encoding="utf-8"?>
<!--
    NODE, landscape. A black field with two centred lines: what the camera is
    doing, and where to watch it.

                           ● REC
              http://192.168.1.50:8080/k7m2x9qa4c/

    textSize values are dp (see dimens.xml) so the system font-scale slider
    cannot reflow a fixed-function appliance layout. Hence SpUsage below.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/node_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/node_bg"
    android:filterTouchesWhenObscured="true"
    tools:ignore="SpUsage">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- What the camera is doing right now: recording, or why not. -->
        <TextView
            android:id="@+id/cam_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/node_accent"
            android:textSize="@dimen/cam_status"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:includeFontPadding="false"
            tools:text="● REC" />

        <!-- Where to watch. Refreshed on every tap. -->
        <TextView
            android:id="@+id/cam_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cam_gap"
            android:textColor="@color/node_secondary"
            android:textSize="@dimen/cam_url"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:includeFontPadding="false"
            tools:text="http://192.168.1.50:8080/k7m2x9qa4c/" />
    </LinearLayout>

</FrameLayout>
