<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sizes are in dp, not sp, on purpose. NODE is a fixed-function appliance:
         MIUI's system font-scale slider must not be able to reflow the layout.
         Lint's SpUsage warning is suppressed in the layout for this reason.
         The eyes size themselves from the screen height in FaceView. -->
    <dimen name="caption">22dp</dimen>
    <dimen name="status">14dp</dimen>
    <dimen name="text_gap">10dp</dimen>
    <dimen name="text_margin">22dp</dimen>

    <!-- The task list: clear of the 10% edges the system swipes from, and of
         the caption and address under it. -->
    <dimen name="tasks_side">96dp</dimen>
    <dimen name="tasks_top">40dp</dimen>
    <dimen name="tasks_bottom">96dp</dimen>
</resources>
