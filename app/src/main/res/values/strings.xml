<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">NODE Companion</string>

    <!-- Every string here reports real state. -->
    <string name="status_no_permission">NEEDS CAMERA PERMISSION · it cannot see you</string>
    <!-- %1$s is a short reason from the camera or the server. -->
    <string name="status_error_fmt">ERROR  %1$s</string>

    <!-- %1$s address, %2$d port, %3$s the random URL key. -->
    <string name="url_fmt">http://%1$s:%2$d/%3$s/</string>
    <string name="url_no_wifi">NO WI-FI</string>

    <!-- Shown, dim, whenever the microphone is open hands-free: just speak, no name needed. -->
    <string name="status_wake">● LISTENING</string>
    <string name="status_online">" · ONLINE"</string>

    <!-- Never the project folder: project names stay off the screen. -->
    <string name="caption_needs_you">NEEDS YOU</string>
    <string name="caption_done">DONE</string>
    <!-- Appended when more sessions are in the same state. %1$d is how many. -->
    <string name="caption_more_fmt">" +%1$d"</string>
    <!-- Claude has been working a long time. %1$d is whole minutes. -->
    <string name="caption_working_fmt">STILL WORKING · %1$dm</string>
    <!-- The phone's own battery. %1$d is degrees Celsius, and percent left. -->
    <string name="caption_battery_hot_fmt">BATTERY HOT · %1$d°C</string>
    <string name="caption_battery_low_fmt">UNPLUGGED · %1$d%%</string>
</resources>
