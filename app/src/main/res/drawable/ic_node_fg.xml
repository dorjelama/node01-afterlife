<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a hollow square with a centre mark. Vector only,
     so the repo carries no binary image assets. The 108x108 canvas has a 72x72
     safe zone; everything here stays well inside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer frame -->
    <path
        android:strokeColor="#FFE8E8E8"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M38,38 L70,38 L70,70 L38,70 Z" />

    <!-- Centre mark -->
    <path
        android:fillColor="#FFE8E8E8"
        android:pathData="M50,50 L58,50 L58,58 L50,58 Z" />
</vector>
