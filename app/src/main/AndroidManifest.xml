<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CAMERA is the front camera's face detection, used only while the
         activity is in front, and nothing it sees leaves the phone. INTERNET
         lets the LAN server hear from the PC. WAKE_LOCK holds a low-latency
         Wi-Fi lock, again only while in front, so a hook is answered at once
         instead of after the radio wakes. RECORD_AUDIO is for voice commands:
         the microphone is open only after a tap or a wave, for one sentence,
         never in the background and never for a wake word. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- From Android 11 an app cannot even see the speech recognizer or the
         text-to-speech engine unless it declares that it looks for them. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Node">

        <activity
            android:name=".NodeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">

            <!-- Normal app launch. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Makes NODE *selectable* as Home, so after a reboot it comes
                 straight back. MIUI keeps its own launcher as default until
                 the user deliberately switches. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
